DB_HOST=localhost
DB_PORT=3306
DB_NAME=personal_blog_db
DB_USERNAME=root
DB_PASSWORD=

# JWT signing secret (>= 32 chars for HS256)
JWT_SECRET=

# Seeded admin account (created on first startup if none exists)
ADMIN_EMAIL=admin@blog.local
ADMIN_PASSWORD=

# Upload root directory (relative to working dir or absolute)
UPLOAD_DIR=./uploads

# Allowed frontend origin(s) for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
